# Copy to .env locally and replace placeholders. Never commit the real .env file.
# Replace with a private, randomly generated value of exactly 32 characters.
PB_ENCRYPTION_KEY=replace-this-key
PUBLIC_APP_URL=https://your-domain.example
VITE_POCKETBASE_URL=https://api.your-domain.example

# Correo (verificación de cuenta y alertas). Elige UNA opción.
# Opción A - SMTP (Gmail con contraseña de aplicación, Brevo, etc.). Sirve para cualquier destinatario.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_ADDRESS=
SMTP_SENDER_NAME=Neptuno
# Opción B - Resend con dominio propio verificado (recomendada al publicar).
BUILDER_MAILER_SENDER_ADDRESS=sender@your-domain.example
BUILDER_MAILER_API_URL=https://api.resend.com
BUILDER_MAILER_API_KEY=replace-with-mail-provider-api-key

NODE_ENV=development
ENABLE_DEMO_USER=false

# Browser smoke test (tests/ui-smoke.spec.ts) reuses PB_URL / PB_ADMIN_* below and UI_URL (default http://127.0.0.1:3000).
# Optional: MOCK_MAIL_URL=http://127.0.0.1:9999 enables the email-verification checks of tools/e2e-smoke.mjs
# (start the mock with: node tools/mock-mail-server.mjs --port 9999).

# Optional local PocketBase end-to-end smoke test. Use a disposable local superuser.
PB_URL=http://127.0.0.1:8090
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=
