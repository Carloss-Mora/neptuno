# Sustituye HOST por tu dirección, por ejemplo neptuno-demo.eastus.cloudapp.azure.com
# Caddy obtiene y renueva solo el certificado HTTPS.
HOST {
	encode gzip

	# PocketBase (API y panel de administración) en la misma dirección que la web
	@pb path /api/* /_/*
	reverse_proxy @pb 127.0.0.1:8090

	# La web (React): cualquier ruta devuelve index.html
	root * /opt/neptuno/apps/web/dist
	try_files {path} /index.html
	file_server
}
